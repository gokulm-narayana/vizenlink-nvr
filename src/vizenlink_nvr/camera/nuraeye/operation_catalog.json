            "type": "string"
          },
          "psk": {
            "type": "string"
          },
          "verify": {
            "type": "boolean",
            "default": true,
            "description": "true = connect & verify before saving; false = save only, no connect attempt. Forced false server-side if the camera is currently reached over Ethernet, regardless of the requested value (NW5 safety override).\n"
          }
        }
      },
      "query": {}
    },
