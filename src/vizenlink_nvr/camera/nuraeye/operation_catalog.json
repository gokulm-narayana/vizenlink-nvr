{
  "source": "camera_api 6b78d89a (2026-11-04)",
  "sha256": "d8d227f3b99576d05e657b10180aca44d25881839e22876469cdc94d205fa13d",
  "operations": {
    "identityChallenge": {
      "method": "POST",
      "path": "/nuraeye/identity",
      "schema": {
        "type": "object",
        "required": [
          "nonce",
          "created",
          "digest"
        ],
        "properties": {
          "nonce": {
            "type": "string",
            "description": "Base64-encoded random nonce",
            "client-generated": null
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "digest": {
            "type": "string",
            "description": "Base64(SHA256(nonce+created+\"are-you-onchip-nuraeye\"))"
          }
        }
      },
      "query": {}
    },
    "sessionLogin": {
      "method": "POST",
      "path": "/nuraeye/session/login",
      "schema": {
        "type": "object",
        "required": [
          "auth_credentials"
        ],
        "properties": {
          "auth_credentials": {
            "type": "object",
            "required": [
              "username",
              "password_digest",
              "nonce",
              "created"
            ],
            "properties": {
              "username": {
                "type": "string"
              },
              "password_digest": {
                "type": "string",
                "description": "Base64(SHA256(nonce+created+device_password))"
              },
              "nonce": {
                "type": "string"
              },
              "created": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "client_label": {
            "type": "string",
            "description": "Optional display label, e.g. \"Mom's iPhone\" \u2014 audit/UX only, never a security boundary"
          }
        }
      },
      "query": {}
    },
